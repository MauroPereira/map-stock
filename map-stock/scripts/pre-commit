#!/bin/bash

# Pre-commit hook to automate GitHub Projects issue management
# This script runs automatically before each commit
# Detects keywords in commit messages and creates/moves issues on the board

echo "Running pre-commit hook..."

# Get commit message from COMMIT_EDITMSG file
commit_msg=$(cat .git/COMMIT_EDITMSG)

echo "Commit message: $commit_msg"

# Check if message contains a keyword
# Available keywords:
# - #backlog    -> Moves to "Backlog"
# - #ready      -> Moves to "Ready"
# - #in-progress -> Moves to "In progress"
# - #review     -> Moves to "In review"
# - #done       -> Moves to "Done"
if [[ "$commit_msg" =~ (#backlog|#ready|#in-progress|#review|#done) ]]; then
    echo "Keyword found, running automation script..."
    # Run automation script using correct path
    python3 "$(git rev-parse --show-toplevel)/map-stock/scripts/github_project_automation.py" "$commit_msg"
else
    echo "No keyword found in message"
fi

# Allow commit to continue
exit 0 
